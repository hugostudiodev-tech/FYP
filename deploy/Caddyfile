# /etc/caddy/Caddyfile — Caddy tự xin và gia hạn chứng chỉ HTTPS (Let's Encrypt)
fyp.hugowishpax.studio {
	encode zstd gzip
	request_body {
		max_size 2GB
	}
	reverse_proxy 127.0.0.1:3000 {
		# Upload/stream video dài: không cắt kết nối giữa chừng
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}
