# Chạy local: sao chép thành .env rồi điền (file .env không đưa lên git). Trên Render: điền ở tab Environment.
PORT=3000
HOST=127.0.0.1

# Google: đọc link Google Drive (bắt buộc để thêm video) + Gemini dự phòng cho sinh viên chưa có khoá riêng
GOOGLE_API_KEY=
# Tuỳ chọn: khoá trình duyệt (giới hạn theo tên miền) để video phát thẳng từ Google, không qua server
DRIVE_BROWSER_KEY=
# Địa chỉ public của API (Render). Để trống khi chạy local.
PUBLIC_API_ORIGIN=
# Tuỳ chọn: Groq dự phòng cho việc chỉ có chữ
GROQ_API_KEY=

# Sao lưu DB lên GitHub (bắt buộc trên Render — gói free không có ổ đĩa bền). Để trống khi chạy local.
GITHUB_DATA_REPO=
GITHUB_DATA_TOKEN=
DB_SECRET=
