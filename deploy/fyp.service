# /etc/systemd/system/fyp.service — chạy nền, tự khởi động lại khi lỗi hoặc khi VPS reboot
[Unit]
Description=Demo Review (fyp.hugowishpax.studio)
After=network.target

[Service]
User=fyp
WorkingDirectory=/opt/fyp
ExecStart=/usr/bin/node --env-file-if-exists=.env server.ts
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
